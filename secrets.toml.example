# Copy to .streamlit/secrets.toml for OIDC development and replace every value.
# Do not commit secrets.toml.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-secret"
client_id = "replace-with-your-identity-provider-client-id"
client_secret = "replace-with-your-identity-provider-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
